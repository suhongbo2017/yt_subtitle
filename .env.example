# 选定提供商：qwen（默认，国内直连） / gemini（需代理） / openai / glm
VISION_PROVIDER=qwen

# --- 只需填对应提供商的 Key ---
# 阿里云百炼（qwen3-vl-plus）
DASHSCOPE_API_KEY=

# Google Gemini（gemini-2.5-flash，手写识别最强，走代理）
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# --- 可选覆盖 ---
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODEL=gemini-2.5-flash
# VISION_PROXY=http://127.0.0.1:7897
# 通用兜底 Key（上面都没填时用它）
VISION_API_KEY=
